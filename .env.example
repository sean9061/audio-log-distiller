# whisper-cli のパス（デフォルト: ./build/bin/whisper-cli）
WHISPER_BIN=/path/to/whisper.cpp/build/bin/whisper-cli

# モデルディレクトリ（デフォルト: ./models）
MODELS_DIR=/path/to/whisper.cpp/models

# Python バイナリ（デフォルト: python3）
# macOS Homebrew の場合: /opt/homebrew/bin/python3.12
# PYTHON=/opt/homebrew/bin/python3.12

# HuggingFace トークン（話者識別に必要）
HF_TOKEN=hf_xxxxx

# Anthropic API キー（会議サマリー生成に必要）
ANTHROPIC_API_KEY=sk-ant-xxxxx
