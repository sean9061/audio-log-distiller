# HuggingFace トークン — 話者識別に必要
# 以下のモデル利用規約に同意してから取得:
#   https://hf.co/pyannote/speaker-diarization-3.1
#   https://hf.co/pyannote/segmentation-3.0
HF_TOKEN=hf_xxxxx

# Ollama 要約設定
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b

# 認証（dashboard と同方式の JWT クッキー認証）
# AUTH_PASSWORD: ログインパスワード（dashboard と同じ値でも可）
# JWT_SECRET: トークン署名用のランダムな秘密鍵（例: openssl rand -hex 32）
# 未設定の場合は安全のため全アクセスを拒否する
AUTH_PASSWORD=changeme
JWT_SECRET=replace-with-a-long-random-secret
